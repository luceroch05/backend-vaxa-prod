# MySQL (tabla empresas_vaxa)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=crecemos
MYSQL_PASSWORD=tu_password_aqui
MYSQL_DATABASE=crecemos_vaxa

# Opcional
# PORT=4000
# BASE_PATH=/backend_vaxa

# ===========================================================
#  Facturación Electrónica — SUNAT (SEE Del Contribuyente)
# ===========================================================
# Ambiente: 'beta' (pruebas/homologación) o 'produccion'
SUNAT_MODO=beta

# Credenciales SOL (usuario SECUNDARIO con perfil de emisión electrónica)
SUNAT_RUC=20615047954
SUNAT_USUARIO_SOL=VAXASYST
SUNAT_CLAVE_SOL=tu_clave_sol_aqui

# Certificado digital para firmar el XML (.pfx/.p12 + su contraseña)
SUNAT_CERT_PATH=./secrets/cert.pfx
SUNAT_CERT_PASSWORD=tu_password_del_pfx_aqui

# Datos fiscales del emisor (van dentro del XML)
SUNAT_RAZON_SOCIAL=VAXA SYSTEM ...
SUNAT_NOMBRE_COMERCIAL=VAXA
SUNAT_UBIGEO=150101
SUNAT_DIRECCION=Av. Ejemplo 123
SUNAT_DISTRITO=Lima
SUNAT_PROVINCIA=Lima
SUNAT_DEPARTAMENTO=Lima
SUNAT_COD_LOCAL=0000

# IGV vigente (Perú = 18%)
SUNAT_IGV_PCT=18

# Consulta de RUC (decolecta.com — token gratis con registro). Solo RUC (dato público de SUNAT).
# El DNI NO se consulta (RENIEC no es público). Sin token, la verificación cae a manual.
# Compatible también con apis.net.pe v1 (https://api.apis.net.pe/v1/ruc) — el parseo tolera ambos.
RUC_API_TOKEN=
RUC_API_URL=https://api.decolecta.com/v1/sunat/ruc
